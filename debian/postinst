#!/bin/sh
# postinst — make installer scripts executable and tell the operator
# what to do next. Run after the .deb's files have been laid down.
set -e

INSTALL_ROOT="/usr/share/ubuntu-ai-system-administrator"

# Re-assert executable bits (dpkg preserves them from the .deb, but be
# defensive in case a future maintainer strips them).
for f in \
  "${INSTALL_ROOT}/scripts/install.sh" \
  "${INSTALL_ROOT}/scripts/uninstall.sh" \
  "${INSTALL_ROOT}/payload/bin"/* \
  /usr/sbin/ubuntu-ai-system-administrator
do
  [ -e "$f" ] || continue
  chmod 0755 "$f" 2>/dev/null || true
done

cat <<'EOF'

Ubuntu AI System Administrator has been staged at
/usr/share/ubuntu-ai-system-administrator/.

Nothing has been changed on this host yet. To install:

  sudo ubuntu-ai-system-administrator --dry-run install      # preview the plan
  sudo ubuntu-ai-system-administrator install                # apply it

To verify or recover an existing install:

  sudo ubuntu-ai-system-administrator verify
  sudo ubuntu-ai-system-administrator doctor
  sudo ubuntu-ai-system-administrator repair

Documentation: /usr/share/doc/ubuntu-ai-system-administrator/README.md and
https://github.com/japer-technology/ubuntu-ai-system-administrator

EOF

exit 0
