#!/usr/bin/env bash
# collect-diagnostics — bundle logs and state for a bug report.
# Secrets are redacted before write.
set -euo pipefail

resolve_install_root() {
  if [[ -n "${AI_SYS_ADMIN_DIR:-}" ]]; then
    printf '%s\n' "${AI_SYS_ADMIN_DIR}"
    return
  fi
  local script_path candidate
  script_path="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null \
    || printf '%s' "${BASH_SOURCE[0]}")"
  if candidate="$(cd -- "$(dirname -- "${script_path}")/.." 2>/dev/null && pwd)"; then
    if [[ "${candidate##*/}" == "payload" \
        && -f "${candidate}/../scripts/install.sh" ]]; then
      printf '%s\n' "/opt/ai-system-administrator"
    else
      printf '%s\n' "${candidate}"
    fi
  else
    printf '%s\n' "/opt/ai-system-administrator"
  fi
}

AI_SYS_ADMIN_DIR="$(resolve_install_root)"

usage() {
  cat <<EOF
collect-diagnostics — bundle redacted logs and state for a bug report.

Usage:
  collect-diagnostics [-h|--help]

Writes a tarball to \${TMPDIR:-/tmp}/ubuntu-ai-system-administrator-diagnostics-<stamp>.tar.gz
containing system info, service status, journal excerpts, the installer
log, the audit log, and the policy file. Token-shaped values (API keys,
SSH keys, KEY/TOKEN/PASSWORD/SECRET assignments) are redacted before
write.

Environment:
  TMPDIR       Output directory for the bundle (default /tmp).
  AI_SYS_ADMIN_DIR   Install root (auto-detected; default /opt/ai-system-administrator).

Review the bundle before sharing it.
EOF
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  "") ;;
  *) echo "collect-diagnostics: unknown argument: $1" >&2; usage >&2; exit 2 ;;
esac

OUT_DIR="${TMPDIR:-/tmp}"
STAMP="$(date -u +%Y%m%d-%H%M%S)"
BUNDLE_DIR="$(mktemp -d "${OUT_DIR}/ubuntu-ai-system-administrator-diagnostics-${STAMP}.XXXX")"
TARBALL="${OUT_DIR}/ubuntu-ai-system-administrator-diagnostics-${STAMP}.tar.gz"

# FIX-3-23: clean up the staging directory on every exit path (tar
# failure, signal, success), not just when the explicit `rm -rf` at
# the bottom is reached.
trap 'rm -rf "${BUNDLE_DIR}"' EXIT

redact() {
  # Strip token-shaped values from stdin to stdout.
  sed -E \
    -e 's/sk-ant-[A-Za-z0-9_-]{12,}/sk-ant-***REDACTED***/g' \
    -e 's/sk-[A-Za-z0-9_-]{12,}/sk-***REDACTED***/g' \
  -e 's/tskey-[A-Za-z0-9_-]{12,}/tskey-***REDACTED***/g' \
  -e 's/(ssh-(rsa|ed25519|dss)) [A-Za-z0-9+/=]{20,}( ?.*)?/\1 ***REDACTED***/g' \
  -e 's/(admin_password_hash|printf '\''%s\\n'\'').*/\1 ***REDACTED***/' \
  -e 's/((API[_-]?KEY|TOKEN|AUTHKEY|PASSWORD|SECRET)([[:space:]]*[:=][[:space:]]*))[^[:space:]]+/\1***REDACTED***/Ig'
}

capture() {
  local name="$1"; shift
  # FIX-3-24: diagnostics collection is best-effort. Many captured
  # commands return non-zero in exactly the broken states we want to
  # diagnose (`systemctl status` of an inactive unit exits 3, for
  # example). Under `set -euo pipefail` an unguarded failure
  # here would abort the whole script before the tarball is written —
  # and the EXIT trap would then delete the partial bundle. Swallow
  # the command's exit status (its output is still captured via 2>&1)
  # so every section is collected regardless of individual failures.
  { echo "## $* (saved $(date -u +%FT%TZ))"; "$@" 2>&1 || true; } | redact > "${BUNDLE_DIR}/${name}"
}

echo "Collecting diagnostics into ${BUNDLE_DIR}/ ..."

capture os-release.txt          cat /etc/os-release
capture uname.txt               uname -a
capture lsb-release.txt         lsb_release -a
capture df.txt                  df -h
capture free.txt                free -h
capture systemctl-failed.txt    systemctl --failed --no-pager
capture systemctl-ai-system-administrator.txt    systemctl status ubuntu-ai-system-administrator-chat.service ubuntu-ai-system-administrator-health.timer --no-pager
capture journal-ai-system-administrator.txt      journalctl -u ubuntu-ai-system-administrator-chat.service -n 400 --no-pager
capture verify.txt              "${AI_SYS_ADMIN_DIR}/bin/verify"
capture health.txt              "${AI_SYS_ADMIN_DIR}/bin/health-check"

# Installer log
if [[ -r /var/log/ubuntu-ai-system-administrator-install.log ]]; then
  redact < /var/log/ubuntu-ai-system-administrator-install.log > "${BUNDLE_DIR}/install.log"
fi

# Audit log (already redacted at write, but redact again defensively)
if [[ -r /var/log/ubuntu-ai-system-administrator/audit.log ]]; then
  redact < /var/log/ubuntu-ai-system-administrator/audit.log > "${BUNDLE_DIR}/audit.log"
fi

# Policy (no secrets in policy file by design)
if [[ -r /etc/ubuntu-ai-system-administrator/policy.yaml ]]; then
  cp /etc/ubuntu-ai-system-administrator/policy.yaml "${BUNDLE_DIR}/policy.yaml"
fi

# Package versions
{
  echo "## dpkg core packages"
  dpkg -l python3 nodejs 2>&1 || true
} | redact > "${BUNDLE_DIR}/packages.txt"

tar -czf "${TARBALL}" -C "$(dirname "${BUNDLE_DIR}")" "$(basename "${BUNDLE_DIR}")"
# FIX-3-23: the EXIT trap removes BUNDLE_DIR; no explicit rm here.

echo
echo "Diagnostic bundle: ${TARBALL}"
echo "Secrets have been redacted, but please review before sharing."
