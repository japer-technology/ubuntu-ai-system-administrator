#!/usr/bin/env bash
# chat — print the local chat URL and the
# operator's debugging entry points. This is the single command a
# tester should run to discover every diagnostic surface the payload
# ships with.
set -euo pipefail

usage() {
  cat <<EOF
chat — print the local chat URL and every diagnostic entry point.

Usage:
  chat [-h|--help]

Environment:
  AI_SYS_ADMIN_CHAT_PORT    Chat port to show in the URL (default 57878).
  AI_SYS_ADMIN_DIR          Install root (auto-detected; default /opt/ai-system-administrator).
EOF
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  "") ;;
  *) echo "chat: unknown argument: $1" >&2; usage >&2; exit 2 ;;
esac

resolve_install_root() {
  if [[ -n "${AI_SYS_ADMIN_DIR:-}" ]]; then
    printf '%s\n' "${AI_SYS_ADMIN_DIR}"
    return
  fi
  local script_path candidate
  script_path="$(readlink -f -- "${BASH_SOURCE[0]}" 2>/dev/null \
    || printf '%s' "${BASH_SOURCE[0]}")"
  if candidate="$(cd -- "$(dirname -- "${script_path}")/.." 2>/dev/null && pwd)"; then
    if [[ "${candidate##*/}" == "payload" \
        && -f "${candidate}/../scripts/install.sh" ]]; then
      printf '%s\n' "/opt/ai-system-administrator"
    else
      printf '%s\n' "${candidate}"
    fi
  else
    printf '%s\n' "/opt/ai-system-administrator"
  fi
}

AI_SYS_ADMIN_DIR="$(resolve_install_root)"
PORT="${AI_SYS_ADMIN_CHAT_PORT:-57878}"
cat <<EOF
Ubuntu AI System Administrator
------------------------------

Local URL:
  http://127.0.0.1:${PORT}/

Service control:
  sudo systemctl status ubuntu-ai-system-administrator-chat.service
  sudo systemctl restart ubuntu-ai-system-administrator-chat.service
  sudo journalctl -u ubuntu-ai-system-administrator-chat.service -f

Health and diagnostics:
  ai-system-administrator-health                       # one-shot health summary
  ai-system-administrator-diagnostics                  # bundle redacted logs + state for bug reports
  sudo ${AI_SYS_ADMIN_DIR}/bin/secrets-edit    # safely edit provider keys

Audit log:
  audit-recent                        # last 25 entries (pretty)
  audit-recent -f                     # stream new entries (tail -F)
  audit-recent -t tool_call -t provider_error
  audit-recent --all                  # full log

Verbose audit (for testing only — opt in on the chat service):
  sudo systemctl edit ubuntu-ai-system-administrator-chat.service
    # add: [Service]
    #      Environment=AI_SYS_ADMIN_AUDIT_VERBOSE=1
  sudo systemctl restart ubuntu-ai-system-administrator-chat.service
  # tool_call entries then include redacted stdout/stderr previews.

EOF
